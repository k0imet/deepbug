  "url_pattern_to_classes": [
    {
      "pattern": "[?&](url|next|redirect|return|callback|target|destination|continue|goto|redir|redirect_uri|returnTo|return_url|checkout_url|success_url|cancel_url|forward|location)=",
      "classes": [
        "open-redirect",
        "ssrf"
      ]
    },
    {
      "pattern": "[?&](id|user|userid|user_id|uid|pid|post|order|invoice|account|accountid|orderid|docid|oid|ref|thread_id|org_id|business_id|migration_id|voucher_id)=\\d",
      "classes": [
        "idor"
      ]
    },
    {
      "pattern": "/(api|rest|v[0-9]|v1|v2|v3|v4)/",
      "classes": [
        "api-misconfig",
        "idor",
        "shadow-api"
      ]
    },
    {
      "pattern": "/graphql",
      "classes": [
        "graphql"
      ]
    },
    {
      "pattern": "/(login|signin|signup|register|forgot|reset|password)",
      "classes": [
        "auth-bypass",
        "ato",
        "forgot-password"
      ]
    },
    {
      "pattern": "/(2fa|mfa|otp|verify)",
      "classes": [
        "mfa-bypass"
      ]
    },
    {
      "pattern": "/(parse-xml|import-xml|\\.xml|soap|wsdl|service\\.asmx|xmlrpc\\.php)",
      "classes": [
        "xxe",
        "auth-bypass"
      ]
    },
    {
      "pattern": "/(file|download|read|doc|document|attachment|content|static|upload/(download))",
      "classes": [
        "lfi",
        "idor"
      ]
    },
    {
      "pattern": "/(proxy|fetch|webhook|callback|notify|import|convert|preview|thumbnail)",
      "classes": [
        "ssrf"
      ]
    },
    {
      "pattern": "/(search|query|filter|sort|keyword)",
