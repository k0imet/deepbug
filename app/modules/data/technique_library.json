  "never_submit": [
    "missing CSP/HSTS/security headers alone",
    "missing SPF/DKIM/DMARC",
    "graphql introspection alone",
    "banner/version disclosure without working CVE",
    "clickjacking on non-sensitive pages",
    "tabnabbing",
    "csv injection without code execution",
    "CORS wildcard without credential exfil proof",
    "logout CSRF",
    "self-xss (own account only)",
    "open redirect alone (no ATO/OAuth chain)",
    "OAuth client_secret in mobile app",
    "SSRF DNS callback only",
    "host header injection alone (no reset poisoning PoC)",
    "rate limit on non-critical forms",
    "session not invalidated on logout",
    "concurrent sessions",
    "internal IP in error message",
    "mixed content",
    "weak SSL ciphers",
    "missing HttpOnly/Secure alone",
    "broken external links",
    "autocomplete on password fields"
  ],
  "auth_sweep_note": "declared-secured != enforced: probe declared-secured OpenAPI ops unauthenticated with junk ids + empty {} bodies; 200/201/202/204/422 = broken. Layer-ordering trap: malformed-body 400 is NOT an auth bypass - resend with well-formed '{}' and expect 401.",
  "sibling_function_rule": "if 9 endpoints under a path enforce auth middleware, the 10th that doesn't is the bug",
  "version_behavioral_diff": "shadow API: old version missing rate limit / weaker auth / extra fields / accepts what new rejects = finding (version difference alone = informational)",
  "timing_statistics": {
    "n_min": 10,
    "interleaved": true,
    "signal": "mean >= 2 sigma above control",
    "single_outlier_warning": "jitter, not signal"
  },
  "marker_discipline": [
    "8+ random alphanumeric chars",
    "never 'test'/'marker'/'evil'/domain names",
    "check baseline response for marker first",
    "sub-tag OOB payloads per sink"
  ],
  "body_diff_rule": "status-code-only bypass claims are the most common N/A; always diff bodies",
  "content_type_rule": "HTML forms need application/x-www-form-urlencoded; API/JSON endpoints need application/json - wrong content-type gives false-negative 200",
  "escalation_paths": {
    "xss": [
      "steal cookie/token -> ATO",
      "HttpOnly? force email change via XHR -> ATO",
      "self-xss + CSRF = Medium"
    ],
    "idor": [
      "read PII -> automate scale",
      "change password/email -> ATO",
      "uuid -> find leak source"
    ],
    "ssrf": [
      "dns-only -> DON'T report, try metadata",
      "metadata keys -> RCE"
    ],
    "sqli": [
      "error-based extract",
      "INTO OUTFILE -> webshell",
      "blind boolean/time"
    ]
  },
