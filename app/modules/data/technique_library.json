  "chain_table": [
    [
      "open-redirect",
      "+ OAuth redirect_uri -> auth code theft",
      "ATO (Critical)"
    ],
    [
      "clickjacking",
      "+ sensitive action + working PoC",
      "Medium"
    ],
    [
      "cors wildcard",
      "+ credentialed request exfils PII",
      "High"
    ],
    [
      "csrf",
      "+ sensitive action (transfer/email change/delete)",
      "High"
    ],
    [
      "rate limit bypass",
      "+ OTP/reset token brute force succeeds",
      "Medium/High"
    ],
    [
      "ssrf dns-only",
      "+ internal service access + data",
      "Medium"
    ],
    [
      "host header",
      "+ password reset email uses injected host",
      "High"
    ],
    [
      "prompt injection",
      "+ reads other user's data (IDOR)",
      "High"
    ],
    [
      "self-xss",
      "+ CSRF to trigger on victim",
      "Medium"
    ],
    [
      "subdomain takeover",
      "+ OAuth redirect_uri at taken subdomain",
      "Critical"
    ],
    [
      "graphql introspection",
      "+ auth bypass mutation or IDOR on node()",
      "High"
    ],
    [
      "open-redirect without chain",
